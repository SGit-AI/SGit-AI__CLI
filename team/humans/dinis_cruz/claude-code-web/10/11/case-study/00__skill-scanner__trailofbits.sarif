{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill-scanner",
          "version": "1.0.0",
          "informationUri": "https://github.com/cisco-ai-defense/skill-scanner",
          "rules": [
            {
              "id": "MANIFEST_MISSING_LICENSE",
              "name": "Manifest Missing License",
              "shortDescription": {
                "text": "Skill does not specify a license"
              },
              "fullDescription": {
                "text": "Skill manifest does not include a 'license' field. Specifying a license helps users understand usage terms."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "policy_violation",
                "severity": "INFO",
                "tags": [
                  "policy_violation",
                  "security"
                ]
              },
              "help": {
                "text": "Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)",
                "markdown": "**Remediation**: Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)"
              }
            },
            {
              "id": "PIPELINE_TAINT_FLOW",
              "name": "Pipeline Taint Flow",
              "shortDescription": {
                "text": "Dangerous data flow in command pipeline"
              },
              "fullDescription": {
                "text": "Pipeline downloads data from the network and executes it: `curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh`. This is a remote code execution pattern. (Note: source host is listed as an installer endpoint, but artifact integrity was not verified.)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "data_exfiltration",
                "severity": "HIGH",
                "tags": [
                  "data_exfiltration",
                  "security"
                ]
              },
              "help": {
                "text": "Review the command pipeline. Avoid piping sensitive data to network commands or shell execution.",
                "markdown": "**Remediation**: Review the command pipeline. Avoid piping sensitive data to network commands or shell execution."
              }
            },
            {
              "id": "CORRELATED_NETWORK_EXECUTION_FLOW",
              "name": "Correlated Network Execution Flow",
              "shortDescription": {
                "text": "Network-derived content reaches code execution"
              },
              "fullDescription": {
                "text": "Correlated network \u2192 code_execution behavior across SKILL.md."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "command_injection",
                "severity": "MEDIUM",
                "tags": [
                  "command_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Verify downloaded content cryptographically and never pass network data to a dynamic interpreter.",
                "markdown": "**Remediation**: Verify downloaded content cryptographically and never pass network data to a dynamic interpreter."
              }
            },
            {
              "id": "COMPOUND_FIND_EXEC",
              "name": "Compound Find Exec",
              "shortDescription": {
                "text": "Discovery and execution chain (find -exec)"
              },
              "fullDescription": {
                "text": "The find command with -exec executes commands on discovered files. An attacker can use this to find and execute hidden malicious scripts."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "command_injection",
                "severity": "CRITICAL",
                "tags": [
                  "command_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Review the command sequence for potential multi-step attacks. Ensure all steps are necessary and safe.",
                "markdown": "**Remediation**: Review the command sequence for potential multi-step attacks. Ensure all steps are necessary and safe."
              }
            },
            {
              "id": "FIND_EXEC_PATTERN",
              "name": "Find Exec Pattern",
              "shortDescription": {
                "text": "find command with -exec flag can execute arbitrary commands on discovered files"
              },
              "fullDescription": {
                "text": "Pattern detected: find \"${output_dir}/findings-index.d\" -maxdepth 1 -type f -name 'worker-*.txt' -exec "
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "command_injection",
                "severity": "HIGH",
                "tags": [
                  "command_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Avoid find -exec with untrusted directories. Use explicit file lists instead",
                "markdown": "**Remediation**: Avoid find -exec with untrusted directories. Use explicit file lists instead"
              }
            },
            {
              "id": "COMPOUND_FETCH_EXECUTE",
              "name": "Compound Fetch Execute",
              "shortDescription": {
                "text": "Remote fetch followed by execution"
              },
              "fullDescription": {
                "text": "Content is downloaded from the network and subsequently executed. This is a classic remote code execution attack pattern. (found in documentation \u2014 may be instructional) (installer endpoint configured; artifact integrity not verified)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "command_injection",
                "severity": "MEDIUM",
                "tags": [
                  "command_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Review the command sequence for potential multi-step attacks. Ensure all steps are necessary and safe.",
                "markdown": "**Remediation**: Review the command sequence for potential multi-step attacks. Ensure all steps are necessary and safe."
              }
            },
            {
              "id": "YARA_code_execution_generic",
              "name": "Yara Code Execution Generic",
              "shortDescription": {
                "text": "CODE EXECUTION detected by YARA"
              },
              "fullDescription": {
                "text": "Generic code execution patterns: ```python"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "command_injection",
                "severity": "MEDIUM",
                "tags": [
                  "command_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Review and remove code execution pattern",
                "markdown": "**Remediation**: Review and remove code execution pattern"
              }
            },
            {
              "id": "ACTIVE_DYNAMIC_EXECUTION",
              "name": "Active Dynamic Execution",
              "shortDescription": {
                "text": "Active instruction invokes dynamic code or process execution"
              },
              "fullDescription": {
                "text": "SKILL.md contains a syntax-confirmed dynamic code or process execution call in active instructions."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "command_injection",
                "severity": "HIGH",
                "tags": [
                  "command_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Remove dynamic execution, use a fixed allowlisted operation, or isolate non-operative examples in an explicit example section.",
                "markdown": "**Remediation**: Remove dynamic execution, use a fixed allowlisted operation, or isolate non-operative examples in an explicit example section."
              }
            },
            {
              "id": "ALLOWED_TOOLS_NETWORK_USAGE",
              "name": "Allowed Tools Network Usage",
              "shortDescription": {
                "text": "Code makes network requests"
              },
              "fullDescription": {
                "text": "Skill code makes network requests. While not controlled by allowed-tools, network access should be documented and justified in the skill description."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "unauthorized_tool_use",
                "severity": "MEDIUM",
                "tags": [
                  "unauthorized_tool_use",
                  "security"
                ]
              },
              "help": {
                "text": "Document network usage in skill description or remove network operations if not needed",
                "markdown": "**Remediation**: Document network usage in skill description or remove network operations if not needed"
              }
            },
            {
              "id": "TOOL_ABUSE_UNDECLARED_NETWORK",
              "name": "Tool Abuse Undeclared Network",
              "shortDescription": {
                "text": "Undeclared network usage"
              },
              "fullDescription": {
                "text": "Skill code uses network libraries but doesn't declare network requirement"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "unauthorized_tool_use",
                "severity": "MEDIUM",
                "tags": [
                  "unauthorized_tool_use",
                  "security"
                ]
              },
              "help": {
                "text": "Declare network usage in compatibility field or remove network calls",
                "markdown": "**Remediation**: Declare network usage in compatibility field or remove network calls"
              }
            },
            {
              "id": "DATA_EXFIL_NETWORK_REQUESTS",
              "name": "Data Exfil Network Requests",
              "shortDescription": {
                "text": "Outbound network request primitives that can transmit data externally"
              },
              "fullDescription": {
                "text": "Pattern detected: urllib.request.Request("
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "data_exfiltration",
                "severity": "MEDIUM",
                "tags": [
                  "data_exfiltration",
                  "security"
                ]
              },
              "help": {
                "text": "Ensure network operations are necessary and document allowed destinations",
                "markdown": "**Remediation**: Ensure network operations are necessary and document allowed destinations"
              }
            },
            {
              "id": "UNDECLARED_NETWORK_DESTINATION",
              "name": "Undeclared Network Destination",
              "shortDescription": {
                "text": "Script contacts a destination the documentation never mentions"
              },
              "fullDescription": {
                "text": "Script contacts or configures 'x' but the skill documentation never visibly mentions it. Undocumented network destinations can indicate behaviour the manifest and description do not disclose."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "unauthorized_tool_use",
                "severity": "LOW",
                "tags": [
                  "unauthorized_tool_use",
                  "security"
                ]
              },
              "help": {
                "text": "Document the destination in SKILL.md (or the manifest description) if it is intended, or remove the undisclosed network access. Organizations can list internal hosts in llm_analysis.trusted_reference_domains.",
                "markdown": "**Remediation**: Document the destination in SKILL.md (or the manifest description) if it is intended, or remove the undisclosed network access. Organizations can list internal hosts in llm_analysis.trusted_reference_domains."
              }
            },
            {
              "id": "PATH_TRAVERSAL_OPEN",
              "name": "Path Traversal Open",
              "shortDescription": {
                "text": "Path traversal vulnerability - user-controlled file path"
              },
              "fullDescription": {
                "text": "Pattern detected: os.path.join(out_dir, filename)\n        with open("
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "command_injection",
                "severity": "CRITICAL",
                "tags": [
                  "command_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Validate and sanitize file paths. Use os.path.realpath() and verify path is within allowed directory",
                "markdown": "**Remediation**: Validate and sanitize file paths. Use os.path.realpath() and verify path is within allowed directory"
              }
            },
            {
              "id": "ALLOWED_TOOLS_BASH_VIOLATION",
              "name": "Allowed Tools Bash Violation",
              "shortDescription": {
                "text": "Code executes bash but Bash tool not in allowed-tools"
              },
              "fullDescription": {
                "text": "Skill restricts tools to ['Bash({baseDir}/scanner.sh:*)', 'Bash(apktool:*)', 'Bash(curl:*)', 'Read', 'Grep', 'Glob'] but code executes bash commands"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "unauthorized_tool_use",
                "severity": "HIGH",
                "tags": [
                  "unauthorized_tool_use",
                  "security"
                ]
              },
              "help": {
                "text": "Add 'Bash' to allowed-tools or remove bash execution from code",
                "markdown": "**Remediation**: Add 'Bash' to allowed-tools or remove bash execution from code"
              }
            },
            {
              "id": "SECRET_GOOGLE_API",
              "name": "Secret Google Api",
              "shortDescription": {
                "text": "Google API key detected"
              },
              "fullDescription": {
                "text": "Pattern detected: AIza****"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "hardcoded_secrets",
                "severity": "CRITICAL",
                "tags": [
                  "hardcoded_secrets",
                  "security"
                ]
              },
              "help": {
                "text": "Remove hardcoded Google API keys",
                "markdown": "**Remediation**: Remove hardcoded Google API keys"
              }
            },
            {
              "id": "SECRET_PASSWORD_VAR",
              "name": "Secret Password Var",
              "shortDescription": {
                "text": "Hardcoded password or secret in variable"
              },
              "fullDescription": {
                "text": "Pattern detected: pass****"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "hardcoded_secrets",
                "severity": "MEDIUM",
                "tags": [
                  "hardcoded_secrets",
                  "security"
                ]
              },
              "help": {
                "text": "Use environment variables or secure vaults for secrets",
                "markdown": "**Remediation**: Use environment variables or secure vaults for secrets"
              }
            },
            {
              "id": "ALLOWED_TOOLS_GREP_VIOLATION",
              "name": "Allowed Tools Grep Violation",
              "shortDescription": {
                "text": "Code uses search/grep patterns but Grep tool not in allowed-tools"
              },
              "fullDescription": {
                "text": "Skill restricts tools to ['Bash', 'Read'] but code uses regex search patterns"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "unauthorized_tool_use",
                "severity": "LOW",
                "tags": [
                  "unauthorized_tool_use",
                  "security"
                ]
              },
              "help": {
                "text": "Add 'Grep' to allowed-tools or remove regex search operations",
                "markdown": "**Remediation**: Add 'Grep' to allowed-tools or remove regex search operations"
              }
            },
            {
              "id": "ACTIVE_REMOTE_ACQUIRE_EXECUTE",
              "name": "Active Remote Acquire Execute",
              "shortDescription": {
                "text": "Active instruction acquires and executes remote content"
              },
              "fullDescription": {
                "text": "SKILL.md contains an operative statement that explicitly coordinates remote content acquisition with execution."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "command_injection",
                "severity": "HIGH",
                "tags": [
                  "command_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Remove remote execution, or require a locally pinned artifact whose digest or signature is verified before a fixed allowlisted invocation.",
                "markdown": "**Remediation**: Remove remote execution, or require a locally pinned artifact whose digest or signature is verified before a fixed allowlisted invocation."
              }
            },
            {
              "id": "HIDDEN_EXECUTABLE_SCRIPT",
              "name": "Hidden Executable Script",
              "shortDescription": {
                "text": "Hidden executable script detected"
              },
              "fullDescription": {
                "text": "Hidden script file found: resources/.zshrc. Hidden files (dotfiles) are often used to conceal malicious code from casual inspection."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "obfuscation",
                "severity": "HIGH",
                "tags": [
                  "obfuscation",
                  "security"
                ]
              },
              "help": {
                "text": "Move script to a visible location or remove if not needed.",
                "markdown": "**Remediation**: Move script to a visible location or remove if not needed."
              }
            },
            {
              "id": "COMMAND_INJECTION_OS_SYSTEM",
              "name": "Command Injection Os System",
              "shortDescription": {
                "text": "Shell command execution with string formatting (potential injection)"
              },
              "fullDescription": {
                "text": "Pattern detected: subprocess.run(\n                        [\"sudo\", \"chown\", \"-R\", f\"{uid}:{gid}"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "command_injection",
                "severity": "CRITICAL",
                "tags": [
                  "command_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Use subprocess with argument lists, not shell strings. Never use user input in shell commands",
                "markdown": "**Remediation**: Use subprocess with argument lists, not shell strings. Never use user input in shell commands"
              }
            },
            {
              "id": "COMMAND_INJECTION_EVAL",
              "name": "Command Injection Eval",
              "shortDescription": {
                "text": "Dangerous code execution functions that can execute arbitrary code"
              },
              "fullDescription": {
                "text": "Pattern detected: compile("
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "command_injection",
                "severity": "CRITICAL",
                "tags": [
                  "command_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Avoid eval(), exec(), and compile(). Use safer alternatives like ast.literal_eval() or operator module",
                "markdown": "**Remediation**: Avoid eval(), exec(), and compile(). Use safer alternatives like ast.literal_eval() or operator module"
              }
            },
            {
              "id": "DATA_EXFIL_SENSITIVE_FILE_GLOB",
              "name": "Data Exfil Sensitive File Glob",
              "shortDescription": {
                "text": "Dynamic enumeration of sensitive files"
              },
              "fullDescription": {
                "text": "scripts/test_merge_sarif.py:197 enumerates files with a glob operation in a scope that also constructs credential-like paths. Dynamic path construction can hide credential harvesting from literal-pattern checks."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "data_exfiltration",
                "severity": "HIGH",
                "tags": [
                  "data_exfiltration",
                  "security"
                ]
              },
              "help": {
                "text": "Do not enumerate credential or configuration files from a skill; use explicit, non-sensitive inputs.",
                "markdown": "**Remediation**: Do not enumerate credential or configuration files from a skill; use explicit, non-sensitive inputs."
              }
            },
            {
              "id": "ALLOWED_TOOLS_WRITE_VIOLATION",
              "name": "Allowed Tools Write Violation",
              "shortDescription": {
                "text": "Skill declares no Write tool but bundled scripts write files"
              },
              "fullDescription": {
                "text": "Skill restricts tools to ['Bash', 'Read', 'Glob', 'Grep'] but bundled scripts appear to write to the filesystem, which conflicts with a read-only tool declaration."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "policy_violation",
                "severity": "MEDIUM",
                "tags": [
                  "policy_violation",
                  "security"
                ]
              },
              "help": {
                "text": "Either add 'Write' to allowed-tools (if intentional) or remove filesystem writes from scripts",
                "markdown": "**Remediation**: Either add 'Write' to allowed-tools (if intentional) or remove filesystem writes from scripts"
              }
            },
            {
              "id": "FILE_MAGIC_MISMATCH",
              "name": "File Magic Mismatch",
              "shortDescription": {
                "text": "File extension does not match actual content type"
              },
              "fullDescription": {
                "text": "File 'openai.yaml' extension (.yaml) suggests one format but Magika detected a different text format: Text protocol buffer (textproto). This may indicate content obfuscation or a misnamed file."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "obfuscation",
                "severity": "MEDIUM",
                "tags": [
                  "obfuscation",
                  "security"
                ]
              },
              "help": {
                "text": "Rename the file to match its actual content type, or remove it if it appears malicious.",
                "markdown": "**Remediation**: Rename the file to match its actual content type, or remove it if it appears malicious."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "MANIFEST_MISSING_LICENSE",
          "level": "note",
          "message": {
            "text": "Skill manifest does not include a 'license' field. Specifying a license helps users understand usage terms."
          },
          "properties": {
            "category": "policy_violation",
            "severity": "INFO",
            "remediation": "Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "trailofbits_skills/plugins/property-based-testing/skills/property-based-testing/SKILL.md",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "fingerprints": {
