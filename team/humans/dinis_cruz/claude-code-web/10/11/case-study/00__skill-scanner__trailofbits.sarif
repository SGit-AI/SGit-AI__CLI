                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 311,
                  "snippet": {
                    "text": "# Canonical index = every finding file on disk. `find` never fails on no-match\n# (an empty findings/ yields an empty index \u2014 the unambiguous \"zero findings\"\n# signal). `sort -u` collapses Phase-7 retry duplicates: replacement workers reuse\n# deterministic ids, so the same path appears once.\nfind \"${"
                  }
                }
              }
            }
          ],
          "fingerprints": {
            "primaryLocationLineHash": "COMPOUND_FIND_EXEC_1db12fc7f3"
          }
